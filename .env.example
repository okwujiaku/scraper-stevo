# Stevo — terminal-only join tracker

USER_TOKEN=
# Group DM channel ID (from discord.com/channels/@me/THIS_NUMBER)
CHAT_ID=1511486061941882930
CLIENT_NAME=Stevo

# all = guild joins + welcome/log bots (recommended). guild = physical joins only.
CAPTURE_MODE=all

# Optional — comma-separated servers to hide guild-join output (leave empty to show all)
HIDE_GUILD_JOIN_SERVERS=

# DEBUG only used when CAPTURE_MODE=all
DEBUG=false

# Post "online" message to group on startup (proves forwarding works)
SEND_STARTUP_PING=true

# Fire one fake capture on startup to test terminal + group (turn off for production)
TEST_CAPTURE=false

# Card date/time timezone — required on Render (UTC server). Example: Africa/Lagos
DISPLAY_TIMEZONE=Africa/Lagos
